# Optional local overrides. Compose already supplies safe defaults.
# Do not put real secrets in this file. Copy to `.env` only if needed.
# Jumbotron Compose does not require an `.env` file.

# RAILS_ENV=development
# MYSQL_HOST=mysql
# MYSQL_USER=root
# MYSQL_PORT=3306
# MYSQL_PASSWORD=root
# BUNDLE_PATH=/bundle
# REDIS_URL=redis://redis
# BUNDLER_RAILS_VERSION=~> 8
